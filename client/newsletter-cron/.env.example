# Copy this file to .env and fill in the blanks. The .env file is gitignored.
# All values are required for the full pipeline unless marked optional.

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_SERVICE_KEY=                      # service_role JWT (NOT the anon key)

# ── Anthropic (used by generator only) ────────────────────────────────────────
ANTHROPIC_API_KEY=                         # sk-ant-... from console.anthropic.com

# ── Telegram (used by scraper) ────────────────────────────────────────────────
# Get API_ID / API_HASH at https://my.telegram.org/apps (user account, NOT a bot).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Group identifier — @username, numeric chat id (e.g. -100xxxxxxxxxx), or exact title.
TELEGRAM_GROUP=

# ── Message backlinks (optional) ──────────────────────────────────────────────
# Each story section links back to the Telegram messages it was written from.
# The base URL is derived from TELEGRAM_GROUP automatically:
#   @aijunkies     -> https://t.me/aijunkies      (public group)
#   -1001234567890 -> https://t.me/c/1234567890   (private supergroup, members only)
# Set this only if TELEGRAM_GROUP is a plain group *title*, which has no URL form.
# Leave blank and backlinks are omitted rather than rendered broken.
TELEGRAM_LINK_BASE=
# Output of `python scrape_telegram.py auth` — leave blank until you run auth once.
TELEGRAM_SESSION_STRING=

# ── GitHub (used by generator HTML commit step) ───────────────────────────────
# Fine-grained PAT with Contents: Read+Write on the newsletter repo.
GITHUB_TOKEN=
GITHUB_REPO=<owner>/<repo>                 # e.g. acme/acme-site

# ── Vercel / site URL ─────────────────────────────────────────────────────────
# Vercel project → Settings → Git → Deploy Hooks → create one for `main`.
VERCEL_DEPLOY_HOOK_URL=
# Public base URL where issues are served, no trailing slash.
NEWSLETTER_BASE_URL=https://<your-site>/newsletter

# ── Where the HTML lives in this repo (production paths — do not change) ─────
# This client's HTML lives under client/public/newsletter/ (the rest of the site
# is in the same monorepo). New clients should use the template repo's defaults
# (`public/newsletter` + `newsletter-TEMPLATE.html`) instead. See the template:
# https://github.com/jbreezyasf/newsletter-pipeline
NEWSLETTER_OUTPUT_DIR=client/public/newsletter
NEWSLETTER_TEMPLATE_FILE=junk-mail-TEMPLATE.html

# ── Notifications (optional — leave any blank to skip that channel) ───────────
# Telegram bot to ship-ping a channel/group. NOT the source group's user account.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=                          # group ids include the -100 prefix
# Slack incoming webhook URL.
SLACK_WEBHOOK_URL=
# Generic webhook for n8n / Make / Zapier / custom agent. Receives a JSON payload.
OPENCLAW_WEBHOOK_URL=
